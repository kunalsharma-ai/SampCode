# Settings for a Docker Compose production deployment (docker-compose.prod.yml, ADR 0042).
# Copy to .env.production on the server, fill in every value marked REQUIRED, and keep the file
# private (chmod 600). It is ignored by git. Full list of optional settings: .env.example.

# ---- Domains (REQUIRED). Each one's DNS A/AAAA record must point at this server. ---------------
STUDIO_DOMAIN=app.example.com
RUNTIME_DOMAIN=survey.example.com
CAPI_DOMAIN=capi.example.com
# Let's Encrypt sends certificate expiry notices here.
ACME_EMAIL=ops@example.com

# ---- Secrets (REQUIRED). Generate each one on its own: openssl rand -hex 32 ----------------------
JWT_SECRET=
SECRETS_KEY=
SIGNING_KEYS_SECRET=

# ---- MongoDB (REQUIRED). Passwords: letters and digits only (openssl rand -hex 24 each). ------
# Set these before the first start: MongoDB creates both users only when its volume is empty.
# The root user is for people and the replica set; the apps connect as the app user.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=sampcode
MONGO_APP_PASSWORD=

# ---- Backups -------------------------------------------------------------------------------------
# A mongodump archive every BACKUP_INTERVAL_HOURS into BACKUP_DIR on the server; the newest BACKUP_KEEP stay.
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# ---- Optional ------------------------------------------------------------------------------------
# Image tag, e.g. the git commit being deployed (scripts in docs/operations/go-live.md set it).
TAG=latest
# Let anyone create an organization from the sign-in page. Off in production: the super admin invites.
ALLOW_SIGNUP=false
LOG_LEVEL=info
# Claude, IPinfo, Deepgram, Twilio, Stripe and S3 can be set later in the studio under
# Settings > Integrations; values here are only the fallback. For example:
# ANTHROPIC_API_KEY=
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=
# EMAIL_FROM=surveys@example.com
# Uploaded files live in the "files" volume. To keep them in S3 instead:
# FILE_STORE=s3
# S3_BUCKET=
# S3_REGION=eu-west-1
# Credentials from the standard AWS variables:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SampAudience (SAMPLEON_* settings: see .env.example)
