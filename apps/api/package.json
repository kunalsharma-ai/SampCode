    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "2.0.0",
    "@types/node": "26.6.5",
    "@types/smtp-server": "3.5.13",
    "@types/supertest": "6.0.3",
    "dotenv-cli": "8.0.0",
    "smtp-server": "3.21.3",
    "supertest": "7.1.1",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "xml-crypto": "6.4.0"
  }
