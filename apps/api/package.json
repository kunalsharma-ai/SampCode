{
  "name": "@zapx/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && dotenv -e ../../.env -- node dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "dotenv -e ../../.env -- vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@aws-sdk/client-s3": "3.1152.0",
    "@node-saml/node-saml": "5.1.0",
    "@zapx/analysis-core": "workspace:*",
    "@zapx/db": "workspace:*",
    "@zapx/logic-engine": "workspace:*",
    "@zapx/quality-core": "workspace:*",
    "@zapx/quantum": "workspace:*",
    "@zapx/redirect-core": "workspace:*",
    "@zapx/survey-schema": "workspace:*",
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "jose": "5.9.6",
    "jsonwebtoken": "9.0.2",
    "mammoth": "1.13.0",
    "multer": "2.5.0",
    "nodemailer": "10.3.1",
    "undici": "7.30.1",
    "zod": "4.6.7"
